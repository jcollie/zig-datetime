.{
    .name = .datetime,
    .version = "0.0.1",
    .minimum_zig_version = "0.16.0",
    .fingerprint = 0x93f3c6caefdaebeb,
    .dependencies = .{
        // Three, and none of them unconditional. moment.js and the three
        // CLDR packages the tables are generated from are declared in
        // `upstream/build.zig.zon` instead: the tables themselves are
        // committed, so a build reads them rather than their sources, and
        // 143 MB stays out of anything that reads this manifest.
        //
        // The IANA timezone database, used only when the build asks for
        // embedded timezone data with -Dembed-tzdata. Both halves are
        // lazy, so an ordinary build neither fetches nor compiles them.
        //
        // These are the two gzip archives IANA publishes; together they
        // hold exactly what tzdb-2026c.tar.lz holds, which Zig's package
        // manager cannot read because it does not support lzip.
        .tzcode = .{
            .url = "https://data.iana.org/time-zones/releases/tzcode2026d.tar.gz",
            .hash = "N-V-__8AABybDwDd46ZHFqBjb0twea7p9vwNzdSzUHFwA55f",
            .lazy = true,
        },
        .tzdata = .{
            .url = "https://data.iana.org/time-zones/releases/tzdata2026d.tar.gz",
            .hash = "N-V-__8AAFiAFQDNovBNmFwF3hznlSfpY7KwAN3Jy7rhie29",
            .lazy = true,
        },
        // Win32 bindings, used only on Windows, where `GetDynamicTimeZoneInformation`
        // is the only way to ask the machine which zone it is set to. Lazy
        // so that builds for other targets never fetch it.
        .zigwin32 = .{
            .url = "git+https://github.com/marlersoft/zigwin32#9f15c276b4e9d05afd34a10d8662a7dfc34647ea",
            .hash = "win32-42.0.39-preview-mX5pFS564gPTezZn4v3TMxRnfJUrZNx1B_F2p2HKXOeG",
            .lazy = true,
        },
    },
    .paths = .{
        "build.zig",
        "build.zig.zon",
        "README.md",
        "LICENSES",
        "REUSE.toml",
        "src",
        "tools",
        // The project of its own that holds the heavy dependencies; see the
        // comment above.
        "upstream",
    },
}
