.{
    .name = .datetime,
    .version = "0.0.1",
    .minimum_zig_version = "0.16.0",
    .fingerprint = 0x93f3c6caefdaebeb,
    .dependencies = .{
        // The IANA timezone database, used only when the build asks for
        // embedded timezone data with -Dembed-tzdata. Both halves are
        // lazy, so an ordinary build neither fetches nor compiles them.
        //
        // These are the two gzip archives IANA publishes; together they
        // hold exactly what tzdb-2026c.tar.lz holds, which Zig's package
        // manager cannot read because it does not support lzip.
        .tzcode = .{
            .url = "https://data.iana.org/time-zones/releases/tzcode2026d.tar.gz",
            .hash = "N-V-__8AABybDwDd46ZHFqBjb0twea7p9vwNzdSzUHFwA55f",
            .lazy = true,
        },
        .tzdata = .{
            .url = "https://data.iana.org/time-zones/releases/tzdata2026d.tar.gz",
            .hash = "N-V-__8AAFiAFQDNovBNmFwF3hznlSfpY7KwAN3Jy7rhie29",
            .lazy = true,
        },
        // moment.js, used only by `zig build oracle`, which checks this
        // library's formatting and parsing against moment itself rather
        // than against what someone remembered of it.
        //
        // Pinned to a version rather than taken from the dev shell,
        // because moment is the specification being tested against and a
        // different release would silently move the target. Lazy, so an
        // ordinary build neither fetches nor unpacks it.
        // Win32 bindings, used only on Windows, where `GetDynamicTimeZoneInformation`
        // is the only way to ask the machine which zone it is set to. Lazy
        // so that builds for other targets never fetch it.
        .zigwin32 = .{
            .url = "git+https://github.com/marlersoft/zigwin32#9f15c276b4e9d05afd34a10d8662a7dfc34647ea",
            .hash = "win32-42.0.39-preview-mX5pFS564gPTezZn4v3TMxRnfJUrZNx1B_F2p2HKXOeG",
            .lazy = true,
        },
        .moment = .{
            .url = "https://registry.npmjs.org/moment/-/moment-2.30.1.tgz",
            .hash = "N-V-__8AAHNhQgCiWfjOCo_LQgx55jnHBr2Z61ZAqPU9n5Uo",
            .lazy = true,
        },
        // The Unicode CLDR, in the JSON distribution the Unicode
        // Consortium publishes, used by -Dembed-cldr and by `zig build
        // oracle-cldr`. Three packages because CLDR is split by what the
        // data is about: the calendars and the timezone name formats are
        // in cldr-dates-full, the week rules and the digits of each
        // numbering system in cldr-core, and which numbering system a
        // locale writes its numbers in is in cldr-numbers-full.
        //
        // Pinned to release 48, which is the release ICU 78 ships, so
        // that the oracle is comparing this library against an ICU that
        // holds the same data rather than a later or earlier one. All
        // three are lazy, so an ordinary build neither fetches nor
        // unpacks them.
        .cldr_core = .{
            .url = "https://registry.npmjs.org/cldr-core/-/cldr-core-48.2.0.tgz",
            .hash = "N-V-__8AAJ77GgCr4jV_q5d8vuaUZIWMrHbXUMYV7il4sgLB",
            .lazy = true,
        },
        .cldr_dates = .{
            .url = "https://registry.npmjs.org/cldr-dates-full/-/cldr-dates-full-48.2.0.tgz",
            .hash = "N-V-__8AAGszqAU24FLBIkgdecxizqeniOtXvaJyJNhnerSV",
            .lazy = true,
        },
        .cldr_numbers = .{
            .url = "https://registry.npmjs.org/cldr-numbers-full/-/cldr-numbers-full-48.2.0.tgz",
            .hash = "N-V-__8AAP5iTQJ7vhRS_dLVKhpakujqxJsIbu89VYJgXryk",
            .lazy = true,
        },
    },
    .paths = .{
        "build.zig",
        "build.zig.zon",
        "README.md",
        "LICENSES",
        "REUSE.toml",
        "src",
        "tools",
    },
}
